# =================================================================
# Unity Project .gitignore
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# =================================================================

# ========== Unity Generated Folders ==========
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]ser[Ss]ettings/

# ========== Visual Studio / MonoDevelop / Rider ==========
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Rider project files
.idea/
*.iml

# ========== OS-Specific Files ==========
.DS_Store
Thumbs.db

# ========== Additional Unity Files ==========
# Ignore Unity cache data
/Library/Bee/
/Library/ScriptAssemblies/
/Library/PlayerDataCache/
/Library/PackageCache/

# Unity auto-generated lightmaps
Lightmap-*_comp_dir

# If you're using Unity Collaborate / Plastic SCM, ignore these:
.Collab/
.Plastic/

# ========== Misc. ==========
# Uncomment if you want to ignore Visual Studio Code settings:
# .vscode/

# Uncomment if you want to keep build artifacts in a specific folder:
# /Builds/

# =================================================================
# End of .gitignore
